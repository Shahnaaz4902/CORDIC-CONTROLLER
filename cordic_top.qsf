# -------------------------------------------------------------------------- #
#
# Quartus Prime
# Project: cordic_top  (pipelined CORDIC accelerator)
#
# This .qsf/.qpf pair is a ready-to-open Quartus Prime project - just open
# cordic_top.qpf in Quartus (File > Open Project) and everything below is
# already configured: source file list, synthesis top-level, and the
# NativeLink simulation testbench.
#
# FAMILY/DEVICE/BOARD below are set to match the Cyclone V SoC Dev Kit
# target used elsewhere in this course's project kit - if your assigned
# board is different, run Assignments > Device... and pick the correct
# part; nothing else in this file needs to change.
#
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY cordic_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name BOARD "Cyclone V SoC Development Kit"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

# ---------------------------------------------------------------------------
# Source files
# ---------------------------------------------------------------------------
# cordic_constants.v is deliberately NOT a VERILOG_FILE entry - it has no
# module of its own (it is a library of `function`/`localparam` declarations
# meant only to be reached via `include from inside another module's body -
# see its own header comment). Adding it as a normal design file would make
# Quartus try to elaborate it as a standalone compilation unit and fail with
# a syntax/parameter-binding error, exactly like it does under a plain
# Verilog simulator if you pass it directly on the command line. Instead it
# is registered as a VERILOG_INCLUDE_FILE, which is Quartus's correct
# mechanism for header-only files: the project tracks it (shows it in the
# Files list, includes it in dependency-driven recompilation) without ever
# compiling it on its own. Quartus's `include search path already checks
# the directory of the including file by default, so as long as this file
# sits next to cordic_stage.v/cordic_preprocess.v/cordic_postprocess.v (all
# in this same project folder), the three `include "cordic_constants.v"
# lines inside those files resolve correctly with no extra search-path
# assignment needed.
set_global_assignment -name VERILOG_INCLUDE_FILE cordic_constants.v

set_global_assignment -name VERILOG_FILE cordic_stage.v
set_global_assignment -name VERILOG_FILE cordic_preprocess.v
set_global_assignment -name VERILOG_FILE cordic_postprocess.v
set_global_assignment -name VERILOG_FILE cordic_top.v
set_global_assignment -name VERILOG_FILE cordic_tb.v

# ---------------------------------------------------------------------------
# Simulation (NativeLink -> ModelSim/Questa)
# ---------------------------------------------------------------------------
# cordic_tb.v is listed above as a VERILOG_FILE (so the project file
# manager tracks it, matching standard Quartus practice) but it is NEVER
# pulled into synthesis: Analysis & Synthesis only walks the design
# hierarchy starting from TOP_LEVEL_ENTITY (cordic_top), and cordic_tb is
# not instantiated anywhere under cordic_top, so it is automatically
# excluded from the synthesized netlist with no extra assignment needed.
# The settings below only control what NativeLink hands to the simulator
# when you run Tools > Run Simulation Tool > RTL Simulation.
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH cordic_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME cordic_tb -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id cordic_tb
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME cordic_tb -section_id cordic_tb
set_global_assignment -name EDA_TEST_BENCH_FILE cordic_tb.v -section_id cordic_tb

# ---------------------------------------------------------------------------
# Timing constraint
# ---------------------------------------------------------------------------
# A clock constraint is required for TimeQuest to report a meaningful Fmax/
# slack (without one, TimeQuest reports "no clocks found" and the numbers
# in the README's "expected synthesis metrics" section won't show up).
# 100 MHz is an arbitrary, comfortably-achievable starting target for this
# design (see README.md "Expected synthesis metrics" for what Fmax to
# actually expect) - tighten it once you've seen your real Fmax if you want
# to explore the design-space tradeoffs also discussed there.
set_global_assignment -name SDC_FILE cordic_top.sdc

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top